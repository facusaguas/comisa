@model GestorNomina.Web.Models.ViewModels.ConceptoLiquidacionViewModel
@using GestorNomina.Web.Models.Enums

@{
    ViewData["Title"] = "Editar Concepto de Liquidación";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-edit me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"></path>
                        <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"></path>
                        <path d="M16 5l3 3"></path>
                    </svg>
                    Editar Concepto de Liquidación
                </h2>
                <div class="text-muted mt-1">Código: <strong>@Model.Codigo</strong></div>
            </div>
            <div class="col-auto ms-auto">
                <a href="@Url.Action("Index")" class="btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <line x1="5" y1="12" x2="9" y2="16" />
                        <line x1="5" y1="12" x2="9" y2="8" />
                    </svg>
                    Volver
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-md-8 col-lg-6 mx-auto">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="card">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Codigo" class="form-label required">Código</label>
                                <input asp-for="Codigo" class="form-control" placeholder="Ej: HN, HE50, JUB" />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                                <small class="form-hint">Código único que identifica el concepto (se convertirá a mayúsculas)</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Nombre" class="form-label required">Nombre</label>
                                <input asp-for="Nombre" class="form-control" placeholder="Ej: Horas Normales, Jubilación" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                                <small class="form-hint">Nombre descriptivo del concepto</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="TipoConcepto" class="form-label required">Tipo de Concepto</label>
                                <select asp-for="TipoConcepto" class="form-select">
                                    <option value="">-- Seleccione un tipo --</option>
                                    <option value="@((int)TipoConcepto.REMUNERATIVO)">Remunerativo</option>
                                    <option value="@((int)TipoConcepto.NO_REMUNERATIVO)">No Remunerativo</option>
                                    <option value="@((int)TipoConcepto.DEDUCCION)">Deducción</option>
                                </select>
                                <span asp-validation-for="TipoConcepto" class="text-danger"></span>
                                <small class="form-hint">
                                    <strong>Remunerativo:</strong> Suma al sueldo bruto (horas, premios, etc.)<br />
                                    <strong>No Remunerativo:</strong> Suma sin aportes (viáticos, bonos, etc.)<br />
                                    <strong>Deducción:</strong> Resta del sueldo (jubilación, obra social, etc.)
                                </small>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <div class="d-flex">
                                <a href="@Url.Action("Index")" class="btn btn-link">Cancelar</a>
                                <button type="submit" class="btn btn-primary ms-auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M5 12l5 5l10 -10" />
                                    </svg>
                                    Guardar Cambios
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
