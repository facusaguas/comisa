@model List<GestorNomina.Web.Models.Entities.Novedad>
@using GestorNomina.Web.Models.Enums

@{
    ViewData["Title"] = "Novedades";
    var userRole = ViewContext.HttpContext.Session.GetString("UserRole");
    var isAdmin = userRole == "Administrador";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M3 12h4l3 8l4 -16l3 8h4"></path>
                    </svg>
                    Novedades de Liquidación
                </h2>
                @if (ViewBag.FiltrosAplicados != null && ((List<string>)ViewBag.FiltrosAplicados).Any())
                {
                    <div class="text-muted mt-1">
                        <strong>Filtros aplicados:</strong> @string.Join(" | ", (List<string>)ViewBag.FiltrosAplicados)
                    </div>
                }
            </div>
            <div class="col-auto ms-auto">
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    Nueva Novedad
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <div class="d-flex"><div>@TempData["Success"]</div></div>
                <a class="btn-close" data-bs-dismiss="alert"></a>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                <div class="d-flex"><div>@TempData["Error"]</div></div>
                <a class="btn-close" data-bs-dismiss="alert"></a>
            </div>
        }

        <!-- Panel de Filtros -->
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M5.5 5h13a1 1 0 0 1 .5 1.5l-5 5.5l0 7l-4 -3l0 -4l-5 -5.5a1 1 0 0 1 .5 -1.5" />
                    </svg>
                    Filtros de Búsqueda
                </h3>
                <div class="card-actions">
                    <a href="#" class="btn btn-sm" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="collapse show" id="filtrosCollapse">
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index")" id="filtrosForm">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Legajo</label>
                                <input type="text" class="form-control" name="legajo" value="@ViewBag.FiltroLegajo" placeholder="Buscar por legajo">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">CUIL</label>
                                <input type="text" class="form-control" name="cuil" value="@ViewBag.FiltroCuil" placeholder="Buscar por CUIL">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Proyecto</label>
                                <select class="form-select" name="proyectoId">
                                    <option value="">Todos los proyectos</option>
                                    @foreach (var proyecto in (SelectList)ViewBag.Proyectos)
                                    {
                                        <option value="@proyecto.Value" selected="@(proyecto.Value == ViewBag.FiltroProyectoId?.ToString())">
                                            @proyecto.Text
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Tipo de Novedad</label>
                                <select class="form-select" name="tipoNovedad">
                                    <option value="">Todos los tipos</option>
                                    @foreach (var tipo in (SelectList)ViewBag.TiposNovedad)
                                    {
                                        <option value="@tipo.Value" selected="@(tipo.Value == ViewBag.FiltroTipoNovedad?.ToString())">
                                            @tipo.Text
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-md-3">
                                <label class="form-label">Periodo (Mes/Año)</label>
                                <input type="month" class="form-control" name="periodo" value="@ViewBag.FiltroPeriodo">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Quincena</label>
                                <select class="form-select" name="quincena">
                                    <option value="">Todas las quincenas</option>
                                    <option value="1" selected="@(ViewBag.FiltroQuincena?.ToString() == "1")">Primera (1)</option>
                                    <option value="2" selected="@(ViewBag.FiltroQuincena?.ToString() == "2")">Segunda (2)</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <circle cx="10" cy="10" r="7" />
                                        <line x1="21" y1="21" x2="15" y2="15" />
                                    </svg>
                                    Filtrar
                                </button>
                                <a href="@Url.Action("Index")" class="btn btn-secondary">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" />
                                        <path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" />
                                    </svg>
                                    Limpiar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="empty">
                        <p class="empty-title">No hay novedades registradas</p>
                        <div class="empty-action">
                            <a href="@Url.Action("Create")" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <line x1="12" y1="5" x2="12" y2="19" />
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                </svg>
                                Crear Novedad
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-striped">
                            <thead>
                                <tr>
                                    <th>Legajo</th>
                                    <th>Empleado</th>
                                    <th>CUIL</th>
                                    <th>Proyecto</th>
                                    <th>Periodo/Quincena</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th>Monto</th>
                                    <th class="w-1">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var novedad in Model)
                                {
                                    <tr>
                                        <td><strong>@novedad.Empleado.Legajo</strong></td>
                                        <td>@novedad.Empleado.Apellido, @novedad.Empleado.Nombre</td>
                                        <td>@(novedad.Empleado.Cuil ?? "-")</td>
                                        <td>@(novedad.Empleado.Proyecto?.Nombre ?? "-")</td>
                                        <td>@novedad.Periodo.ToString("yyyy-MM") / Q@novedad.Quincena</td>
                                        <td>
                                            @switch (novedad.TipoNovedad)
                                            {
                                                case TipoNovedadLiquidacion.Embargo:
                                                    <span class="badge bg-danger">Embargo</span>
                                                    break;
                                                case TipoNovedadLiquidacion.InicioRoster:
                                                    <span class="badge bg-success">Inicio Roster</span>
                                                    break;
                                                case TipoNovedadLiquidacion.FinRoster:
                                                    <span class="badge bg-warning">Fin Roster</span>
                                                    break;
                                                case TipoNovedadLiquidacion.Enfermedad:
                                                    <span class="badge bg-info">Enfermedad</span>
                                                    break;
                                                case TipoNovedadLiquidacion.Baja:
                                                    <span class="badge bg-dark">Baja</span>
                                                    break;
                                                case TipoNovedadLiquidacion.Vacaciones:
                                                    <span class="badge bg-purple">Vacaciones</span>
                                                    break;
                                                case TipoNovedadLiquidacion.Anticipo:
                                                    <span class="badge bg-orange">Anticipo</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@novedad.FechaNovedad.ToString("dd/MM/yyyy")</td>
                                        <td>@(novedad.MontoNovedad.HasValue ? novedad.MontoNovedad.Value.ToString("C") : "-")</td>
                                        <td>
                                            <div class="btn-list flex-nowrap">
                                                <a href="@Url.Action("Edit", new { id = novedad.Id })" class="btn btn-sm btn-icon btn-primary" title="Editar">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                                        <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                                                        <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                                                        <path d="M16 5l3 3" />
                                                    </svg>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-icon btn-danger" onclick="confirmarEliminacion(@novedad.Id, '@novedad.Empleado.Legajo')" title="Eliminar">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                                        <line x1="4" y1="7" x2="20" y2="7" />
                                                        <line x1="10" y1="11" x2="10" y2="17" />
                                                        <line x1="14" y1="11" x2="14" y2="17" />
                                                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                                                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    function confirmarEliminacion(id, legajo) {
        if (confirm(`¿Está seguro que desea eliminar la novedad del empleado ${legajo}?`)) {
            const form = document.getElementById('deleteForm');
            form.action = '@Url.Action("Delete")/' + id;
            form.submit();
        }
    }
</script>
