@model GestorNomina.Web.Models.ViewModels.NovedadViewModel
@using GestorNomina.Web.Models.Enums

@{
    ViewData["Title"] = "Nueva Novedad";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Nueva Novedad</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="@Url.Action("Index")" class="btn">Volver</a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-md-10 col-lg-8 mx-auto">
                <form asp-action="Create" method="post">
                    <div class="card">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="row mb-3">
                                <div class="col-md-12">
                                    <label asp-for="EmpleadoId" class="form-label required">Empleado</label>
                                    <select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.Empleados">
                                        <option value="">-- Seleccione un empleado --</option>
                                    </select>
                                    <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Periodo" class="form-label required">Periodo</label>
                                    <input asp-for="Periodo" type="month" class="form-control" />
                                    <span asp-validation-for="Periodo" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Quincena" class="form-label required">Quincena</label>
                                    <select asp-for="Quincena" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="1">Primera (1)</option>
                                        <option value="2">Segunda (2)</option>
                                    </select>
                                    <span asp-validation-for="Quincena" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="TipoNovedad" class="form-label required">Tipo de Novedad</label>
                                    <select asp-for="TipoNovedad" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="@((int)TipoNovedadLiquidacion.Embargo)">Embargo</option>
                                        <option value="@((int)TipoNovedadLiquidacion.InicioRoster)">Inicio Roster</option>
                                        <option value="@((int)TipoNovedadLiquidacion.FinRoster)">Fin Roster</option>
                                        <option value="@((int)TipoNovedadLiquidacion.Enfermedad)">Enfermedad</option>
                                        <option value="@((int)TipoNovedadLiquidacion.Baja)">Baja</option>
                                        <option value="@((int)TipoNovedadLiquidacion.Vacaciones)">Vacaciones</option>
                                        <option value="@((int)TipoNovedadLiquidacion.Anticipo)">Anticipo</option>
                                    </select>
                                    <span asp-validation-for="TipoNovedad" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="FechaNovedad" class="form-label required">Fecha de Novedad</label>
                                    <input asp-for="FechaNovedad" type="date" class="form-control" />
                                    <span asp-validation-for="FechaNovedad" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="MontoNovedad" class="form-label">Monto</label>
                                    <input asp-for="MontoNovedad" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="MontoNovedad" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <div class="d-flex">
                                <a href="@Url.Action("Index")" class="btn btn-link">Cancelar</a>
                                <button type="submit" class="btn btn-primary ms-auto">Crear Novedad</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
