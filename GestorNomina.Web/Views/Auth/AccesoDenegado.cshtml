@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_LoginLayout";
}

<div class="card card-md login-card">
    <div class="card-body text-center py-5">
        <div class="mb-4">
            <i class="ti ti-lock-access" style="font-size: 5rem; color: #d63939;"></i>
        </div>
        
        <h2 class="card-title mb-3">Acceso Denegado</h2>
        
        <p class="text-muted mb-4">
            No tienes permisos suficientes para acceder a esta página o recurso.
        </p>

        <div class="alert alert-warning text-start">
            <div class="d-flex">
                <div>
                    <i class="ti ti-alert-triangle icon alert-icon"></i>
                </div>
                <div>
                    <h4 class="alert-title">¿Por qué veo esto?</h4>
                    <div class="text-muted">
                        Esta página o funcionalidad requiere permisos especiales que tu cuenta actual no posee.
                        Si crees que deberías tener acceso, contacta al administrador del sistema.
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a href="/" class="btn btn-primary">
                <i class="ti ti-home icon"></i>
                Volver al Inicio
            </a>
            <a href="/Auth/Logout" class="btn btn-outline-secondary">
                <i class="ti ti-logout icon"></i>
                Cerrar Sesión
            </a>
        </div>
    </div>
</div>

<div class="text-center text-white mt-4">
    <small>
        Si necesitas asistencia, contacta al administrador del sistema
    </small>
</div>
