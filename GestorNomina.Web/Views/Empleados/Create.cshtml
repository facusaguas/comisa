@model GestorNomina.Web.Models.ViewModels.EmpleadoViewModel

@{
    ViewData["Title"] = "Nuevo Empleado";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Nuevo Empleado</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a asp-action="Index" class="btn btn-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
                    Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-12">
                <form asp-action="Create" method="post">
                    
                    <!-- Datos Personales -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h3 class="card-title">Datos Personales</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Nombre" class="form-label required">Nombre</label>
                                        <input asp-for="Nombre" class="form-control" placeholder="Nombre del empleado" />
                                        <span asp-validation-for="Nombre" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Apellido" class="form-label required">Apellido</label>
                                        <input asp-for="Apellido" class="form-control" placeholder="Apellido del empleado" />
                                        <span asp-validation-for="Apellido" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Legajo" class="form-label required">Legajo</label>
                                        <input asp-for="Legajo" class="form-control" placeholder="Ej: 001234" />
                                        <span asp-validation-for="Legajo" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="DocumentoIdentidad" class="form-label">Documento de Identidad</label>
                                        <input asp-for="DocumentoIdentidad" class="form-control" placeholder="Ej: 12345678" />
                                        <span asp-validation-for="DocumentoIdentidad" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label asp-for="Cuil" class="form-label">CUIL</label>
                                        <input asp-for="Cuil" class="form-control" placeholder="Ej: 20-12345678-9" />
                                        <span asp-validation-for="Cuil" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label asp-for="Domicilio" class="form-label">Domicilio</label>
                                        <input asp-for="Domicilio" class="form-control" placeholder="Ej: Calle Falsa 123" />
                                        <span asp-validation-for="Domicilio" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProvinciaId" class="form-label">Provincia</label>
                                        <select asp-for="ProvinciaId" class="form-select" id="provinciaSelect">
                                            <option value="">Seleccione una provincia...</option>
                                            @if (ViewBag.Provincias != null)
                                            {
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Provincias)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="ProvinciaId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="CiudadId" class="form-label">Ciudad</label>
                                        <select asp-for="CiudadId" class="form-select" id="ciudadSelect">
                                            <option value="">Seleccione primero una provincia...</option>
                                        </select>
                                        <span asp-validation-for="CiudadId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="FechaIngreso" class="form-label required">Fecha de Ingreso</label>
                                        <input asp-for="FechaIngreso" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="FechaAlta" class="form-label">Fecha de Alta</label>
                                        <input asp-for="FechaAlta" type="date" class="form-control" />
                                        <span asp-validation-for="FechaAlta" class="text-danger"></span>
                                        <small class="form-hint">Fecha de alta en el sistema de liquidación</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="FechaBaja" class="form-label">Fecha de Baja</label>
                                        <input asp-for="FechaBaja" type="date" class="form-control" />
                                        <span asp-validation-for="FechaBaja" class="text-danger"></span>
                                        <small class="form-hint">Fecha en que el empleado causó baja</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="mb-3">
                                        <label asp-for="FormaPago" class="form-label">Forma de Pago</label>
                                        <select asp-for="FormaPago" class="form-select">
                                            <option value="1">Quincenal</option>
                                            <option value="2">Mensual</option>
                                        </select>
                                        <span asp-validation-for="FormaPago" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="RegimenId" class="form-label required">Régimen Laboral</label>
                                        <select asp-for="RegimenId" class="form-select">
                                            <option value="">Seleccione un régimen...</option>
                                            @if (ViewBag.Regimenes != null)
                                            {
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Regimenes)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="RegimenId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ProyectoId" class="form-label">Proyecto Actual</label>
                                        <select asp-for="ProyectoId" class="form-select">
                                            <option value="">Sin asignar</option>
                                            @if (ViewBag.Proyectos != null)
                                            {
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Proyectos)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="ProyectoId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="Activo" class="form-label">Estado</label>
                                        <select asp-for="Activo" class="form-select">
                                            <option value="">Pendiente</option>
                                            <option value="true" selected>Activo</option>
                                            <option value="false">Inactivo</option>
                                        </select>
                                        <span asp-validation-for="Activo" class="text-danger"></span>
                                        <small class="form-hint">Pendiente: aún no definido | Activo: trabajando | Inactivo: dado de baja</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Datos de Liquidación -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h3 class="card-title">Datos de Liquidación</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ConvenioId" class="form-label">Convenio</label>
                                        <select asp-for="ConvenioId" class="form-select" id="convenioSelect">
                                            <option value="">Seleccione un convenio...</option>
                                            @if (ViewBag.Convenios != null)
                                            {
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Convenios)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="ConvenioId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="CategoriaId" class="form-label">Categoría</label>
                                        <select asp-for="CategoriaId" class="form-select" id="categoriaSelect">
                                            <option value="">Seleccione primero un convenio...</option>
                                        </select>
                                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="TipoLiquidacionId" class="form-label">Tipo de Liquidación</label>
                                        <select asp-for="TipoLiquidacionId" asp-items="ViewBag.TiposLiquidacion" class="form-select">
                                            <option value="">Seleccione un tipo...</option>
                                        </select>
                                        <span asp-validation-for="TipoLiquidacionId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="DisciplinaId" class="form-label">Disciplina</label>
                                        <select asp-for="DisciplinaId" class="form-select">
                                            <option value="">Seleccione una disciplina...</option>
                                            @if (ViewBag.Disciplinas != null)
                                            {
                                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Disciplinas)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="DisciplinaId" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ValorHoraBasico" class="form-label">Valor Hora Básico</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="ValorHoraBasico" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="ValorHoraBasico" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label asp-for="ValorConvenidoDiario" class="form-label">Valor Convenido Diario</label>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="ValorConvenidoDiario" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                        </div>
                                        <span asp-validation-for="ValorConvenidoDiario" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <div class="form-check form-switch">
                                            <input asp-for="AplicaPlusAltura" class="form-check-input" type="checkbox" />
                                            <label asp-for="AplicaPlusAltura" class="form-check-label">Aplica Plus por Altura</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <div class="form-check form-switch">
                                            <input asp-for="AplicaPlusElectrico" class="form-check-input" type="checkbox" />
                                            <label asp-for="AplicaPlusElectrico" class="form-check-label">Aplica Plus Eléctrico</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción -->
                    <div class="card">
                        <div class="card-footer text-end">
                            <div class="d-flex">
                                <a asp-action="Index" class="btn btn-link">Cancelar</a>
                                <button type="submit" class="btn btn-primary ms-auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
                                    Crear Empleado
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Dropdown dependiente: Convenio -> Categoría (Vanilla JavaScript)
        document.addEventListener('DOMContentLoaded', function() {
            const convenioSelect = document.getElementById('convenioSelect');
            const categoriaSelect = document.getElementById('categoriaSelect');
            const provinciaSelect = document.getElementById('provinciaSelect');
            const ciudadSelect = document.getElementById('ciudadSelect');
            
            // ========================================
            // CONVENIO -> CATEGORÍA
            // ========================================
            if (convenioSelect && categoriaSelect) {
                convenioSelect.addEventListener('change', function() {
                    const convenioId = this.value;
                    
                    if (!convenioId) {
                        categoriaSelect.innerHTML = '<option value="">Seleccione primero un convenio...</option>';
                        categoriaSelect.disabled = true;
                        return;
                    }
                    
                    fetch('@Url.Action("GetCategoriasByConvenio", "Empleados")?convenioId=' + convenioId)
                        .then(response => response.json())
                        .then(data => {
                            categoriaSelect.innerHTML = '<option value="">Seleccione una categoría...</option>';
                            
                            if (data && data.length > 0) {
                                data.forEach(item => {
                                    const option = document.createElement('option');
                                    option.value = item.id;
                                    option.textContent = item.nombre;
                                    categoriaSelect.appendChild(option);
                                });
                                categoriaSelect.disabled = false;
                            } else {
                                categoriaSelect.innerHTML = '<option value="">No hay categorías disponibles</option>';
                                categoriaSelect.disabled = true;
                            }
                        })
                        .catch(error => {
                            console.error('Error al cargar categorías:', error);
                            categoriaSelect.innerHTML = '<option value="">Error al cargar categorías</option>';
                            categoriaSelect.disabled = true;
                        });
                });
                
                if (convenioSelect.value) {
                    convenioSelect.dispatchEvent(new Event('change'));
                }
            }
            
            // ========================================
            // PROVINCIA -> CIUDAD
            // ========================================
            if (provinciaSelect && ciudadSelect) {
                provinciaSelect.addEventListener('change', function() {
                    const provinciaId = this.value;
                    
                    if (!provinciaId) {
                        ciudadSelect.innerHTML = '<option value="">Seleccione primero una provincia...</option>';
                        ciudadSelect.disabled = true;
                        return;
                    }
                    
                    fetch('@Url.Action("GetCiudadesByProvincia", "Empleados")?provinciaId=' + provinciaId)
                        .then(response => response.json())
                        .then(data => {
                            ciudadSelect.innerHTML = '<option value="">Seleccione una ciudad...</option>';
                            
                            if (data && data.length > 0) {
                                data.forEach(item => {
                                    const option = document.createElement('option');
                                    option.value = item.id;
                                    option.textContent = item.nombre + ' (CP: ' + item.codigoPostal + ')';
                                    ciudadSelect.appendChild(option);
                                });
                                ciudadSelect.disabled = false;
                            } else {
                                ciudadSelect.innerHTML = '<option value="">No hay ciudades disponibles</option>';
                                ciudadSelect.disabled = true;
                            }
                        })
                        .catch(error => {
                            console.error('Error al cargar ciudades:', error);
                            ciudadSelect.innerHTML = '<option value="">Error al cargar ciudades</option>';
                            ciudadSelect.disabled = true;
                        });
                });
                
                if (provinciaSelect.value) {
                    provinciaSelect.dispatchEvent(new Event('change'));
                }
            }
        });
    </script>
}
