@model List<GestorNomina.Web.Models.ViewModels.EmpleadoViewModel>

@{
    ViewData["Title"] = "Gestión de Empleados";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalEmpleados = ViewBag.TotalEmpleados ?? 0;
    var pageSize = ViewBag.PageSize ?? 10;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-users" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
                        <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        <path d="M21 21v-2a4 4 0 0 0 -3 -3.85"></path>
                    </svg>
                    Empleados
                </h2>
                <div class="text-muted mt-1">@totalEmpleados empleados encontrados</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="CargarDesdePDF" class="btn btn-info d-none d-sm-inline-block">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><line x1="12" y1="11" x2="12" y2="17" /><polyline points="9 14 12 17 15 14" /></svg>
                        Cargar desde PDF
                    </a>
                    <a asp-action="Create" class="btn btn-primary d-none d-sm-inline-block">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Nuevo Empleado
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Filtros de Búsqueda</h3>
                    </div>
                    <div class="card-body">
                        <form method="get" asp-action="Index" id="filtrosForm">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Nombre</label>
                                    <input type="text" class="form-control" name="nombre" value="@ViewBag.FiltroNombre" placeholder="Buscar por nombre">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Apellido</label>
                                    <input type="text" class="form-control" name="apellido" value="@ViewBag.FiltroApellido" placeholder="Buscar por apellido">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">CUIL</label>
                                    <input type="text" class="form-control" name="cuil" value="@ViewBag.FiltroCuil" placeholder="Buscar por CUIL">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Proyecto Actual</label>
                                    <select class="form-select" name="proyectoId">
                                        <option value="">Todos</option>
                                        @if (ViewBag.Proyectos != null)
                                        {
                                            @foreach (var proyecto in ViewBag.Proyectos)
                                            {
                                                <option value="@proyecto.Id" selected="@(ViewBag.FiltroProyectoId == proyecto.Id)">@proyecto.Nombre</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Estado</label>
                                    <select class="form-select" name="activo">
                                        <option value="">Todos</option>
                                        <option value="true" selected="@(ViewBag.FiltroActivo == true)">Activos</option>
                                        <option value="false" selected="@(ViewBag.FiltroActivo == false)">Inactivos</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="10" cy="10" r="7" /><line x1="21" y1="21" x2="15" y2="15" /></svg>
                                        Buscar
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>
                                        Limpiar Filtros
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Listado de Empleados</h3>
                        <div class="ms-auto text-muted">
                            Mostrando @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, totalEmpleados) de @totalEmpleados empleados
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-striped">
                            <thead>
                                <tr>
                                    <th>Legajo</th>
                                    <th>Apellido y Nombre</th>
                                    <th>CUIL</th>
                                    <th>Cargo</th>
                                    <th>Régimen</th>
                                    <th>Fecha Ingreso</th>
                                    <th>Proyecto Actual</th>
                                    <th>Estado</th>
                                    <th class="w-1">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Count == 0)
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            <div class="empty">
                                                <div class="empty-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="10" cy="10" r="7" /><line x1="21" y1="21" x2="15" y2="15" /></svg>
                                                </div>
                                                <p class="empty-title">No se encontraron empleados</p>
                                                <p class="empty-subtitle text-muted">
                                                    Intenta ajustar los filtros de búsqueda o crear un nuevo empleado
                                                </p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var empleado in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@empleado.Legajo</strong>
                                            </td>
                                            <td>
                                                @empleado.Apellido, @empleado.Nombre
                                            </td>
                                            <td>@(empleado.Cuil ?? "-")</td>
                                            <td>@(empleado.Cargo ?? "-")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(empleado.RegimenNombre))
                                                {
                                                    <span class="badge bg-blue-lt">@empleado.RegimenNombre</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>@(empleado.FechaIngreso?.ToString("dd/MM/yyyy") ?? "-")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(empleado.ProyectoNombre))
                                                {
                                                    <span class="badge bg-green-lt">@empleado.ProyectoNombre</span>
                                                }
                                                else if (empleado.ProyectosAsignados != null && empleado.ProyectosAsignados.Any())
                                                {
                                                    <span class="badge bg-green">@empleado.ProyectosAsignados.Count proyectos</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin asignar</span>
                                                }
                                            </td>
                                            <td>
                                                @if (empleado.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@empleado.Id" class="btn btn-sm btn-icon btn-ghost-secondary" title="Ver Detalles">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@empleado.Id" class="btn btn-sm btn-icon btn-ghost-primary" title="Editar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@empleado.Id" class="btn btn-sm btn-icon btn-ghost-danger" title="Eliminar">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="4" y1="7" x2="20" y2="7" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (totalPages > 1)
                    {
                        <div class="card-footer d-flex align-items-center">
                            <p class="m-0 text-muted">
                                Mostrando página @currentPage de @totalPages
                            </p>
                            <ul class="pagination m-0 ms-auto">
                                @* Botón Primera Página *@
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { nombre = ViewBag.FiltroNombre, apellido = ViewBag.FiltroApellido, cuil = ViewBag.FiltroCuil, proyectoId = ViewBag.FiltroProyectoId, activo = ViewBag.FiltroActivo, page = 1 })" tabindex="-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="11 7 6 12 11 17" /><polyline points="17 7 12 12 17 17" /></svg>
                                    </a>
                                </li>

                                @* Botón Anterior *@
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { nombre = ViewBag.FiltroNombre, apellido = ViewBag.FiltroApellido, cuil = ViewBag.FiltroCuil, proyectoId = ViewBag.FiltroProyectoId, activo = ViewBag.FiltroActivo, page = currentPage - 1 })">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="15 6 9 12 15 18" /></svg>
                                        Anterior
                                    </a>
                                </li>

                                @* Páginas numeradas *@
                                @{
                                    var startPage = Math.Max(1, currentPage - 2);
                                    var endPage = Math.Min(totalPages, currentPage + 2);

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { nombre = ViewBag.FiltroNombre, apellido = ViewBag.FiltroApellido, cuil = ViewBag.FiltroCuil, proyectoId = ViewBag.FiltroProyectoId, activo = ViewBag.FiltroActivo, page = i })">@i</a>
                                        </li>
                                    }
                                }

                                @* Botón Siguiente *@
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { nombre = ViewBag.FiltroNombre, apellido = ViewBag.FiltroApellido, cuil = ViewBag.FiltroCuil, proyectoId = ViewBag.FiltroProyectoId, activo = ViewBag.FiltroActivo, page = currentPage + 1 })">
                                        Siguiente
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 6 15 12 9 18" /></svg>
                                    </a>
                                </li>

                                @* Botón Última Página *@
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { nombre = ViewBag.FiltroNombre, apellido = ViewBag.FiltroApellido, cuil = ViewBag.FiltroCuil, proyectoId = ViewBag.FiltroProyectoId, activo = ViewBag.FiltroActivo, page = totalPages })">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="7 7 12 12 7 17" /><polyline points="13 7 18 12 13 17" /></svg>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
