@model GestorNomina.Web.Models.ViewModels.CargarEmpleadosPdfViewModel

@{
    ViewData["Title"] = "Cargar Empleados desde PDF";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><line x1="12" y1="11" x2="12" y2="17" /><polyline points="9 14 12 17 15 14" /></svg>
                    Cargar Empleados desde PDF
                </h2>
                <div class="text-muted mt-1">Importar múltiples empleados desde archivos PDF</div>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Index" class="btn">Volver a Empleados</a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-lg-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Seleccionar Archivos PDF</h3>
                    </div>
                    <div class="card-body">
                        <form asp-action="ProcesarPDFs" method="post" enctype="multipart/form-data">
                            <div class="mb-3">
                                <label class="form-label">Archivos PDF <span class="text-danger">*</span></label>
                                <div class="form-control form-control-lg p-4 text-center" id="dropZone" style="border: 2px dashed #ccc; cursor: pointer; background: #f8f9fa;">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon mb-2 text-muted" width="48" height="48" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M14 3v4a1 1 0 0 0 1 1h4"/>
                                        <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/>
                                        <line x1="12" y1="11" x2="12" y2="17"/>
                                        <polyline points="9 14 12 17 15 14"/>
                                    </svg>
                                    <p class="mb-0">
                                        <strong>Arrastra archivos PDF aquí</strong>
                                        <br>
                                        <small class="text-muted">o haz clic para seleccionar</small>
                                    </p>
                                    <input type="file" id="fileInput" name="archivos" multiple accept=".pdf" style="display: none;">
                                </div>
                                <small class="text-muted">
                                    <strong>Nota:</strong> Los PDFs deben contener: Nombre, Apellido, CUIT, Fecha de Inicio (opcional) y Retrib. Pactada (opcional)
                                </small>
                            </div>

                            <div id="fileList" class="mb-3" style="display: none;">
                                <label class="form-label">Archivos Seleccionados:</label>
                                <div id="selectedFiles" class="list-group"></div>
                            </div>

                            <div class="form-footer">
                                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M9 11l3 3l8 -8"/>
                                        <path d="M20 12a9 9 0 1 1 -18 0a9 9 0 0 1 18 0z"/>
                                    </svg>
                                    Procesar PDFs
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Información de ayuda -->
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title">Instrucciones</h3>
                    </div>
                    <div class="card-body">
                        <p><strong>¿Cómo usar esta funcionalidad?</strong></p>
                        <ol>
                            <li>Selecciona uno o más archivos PDF que contengan información de empleados</li>
                            <li>El sistema extraerá automáticamente:
                                <ul>
                                    <li><strong>Nombre</strong> (requerido)</li>
                                    <li><strong>Apellido</strong> (requerido)</li>
                                    <li><strong>CUIT</strong> (requerido - usado para identificar empleados existentes)</li>
                                    <li><strong>Fecha de Inicio</strong> (opcional)</li>
                                    <li><strong>Retrib. Pactada</strong> (opcional)</li>
                                </ul>
                            </li>
                            <li>Si el CUIT no existe: Se creará un nuevo empleado con legajo automático</li>
                            <li>Si el CUIT existe: Se reactivará el empleado y se actualizará su fecha de inicio</li>
                            <li>Verás un resumen con el resultado de cada empleado procesado</li>
                        </ol>

                        <p class="mt-3"><strong>Requisitos de los PDFs:</strong></p>
                        <ul>
                            <li>Formato: PDF estándar</li>
                            <li>Contenga los datos en texto plano (no en imágenes)</li>
                            <li>Los datos pueden estar en cualquier posición del documento</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        const selectedFiles = document.getElementById('selectedFiles');
        const submitBtn = document.getElementById('submitBtn');

        // Drag and drop
        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.style.backgroundColor = '#e3f2fd';
            dropZone.style.borderColor = '#2196F3';
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.style.backgroundColor = '#f8f9fa';
            dropZone.style.borderColor = '#ccc';
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.style.backgroundColor = '#f8f9fa';
            dropZone.style.borderColor = '#ccc';

            const files = e.dataTransfer.files;
            fileInput.files = files;
            updateFileList();
        });

        fileInput.addEventListener('change', updateFileList);

        function updateFileList() {
            const files = fileInput.files;

            if (files.length === 0) {
                fileList.style.display = 'none';
                selectedFiles.innerHTML = '';
                submitBtn.disabled = true;
                return;
            }

            selectedFiles.innerHTML = '';
            for (let file of files) {
                const item = document.createElement('div');
                item.className = 'list-group-item';
                item.innerHTML = `
                    <div class="d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-danger me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M14 3v4a1 1 0 0 0 1 1h4"/>
                            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/>
                        </svg>
                        <div>
                            <strong>${file.name}</strong>
                            <br>
                            <small class="text-muted">${(file.size / 1024 / 1024).toFixed(2)} MB</small>
                        </div>
                    </div>
                `;
                selectedFiles.appendChild(item);
            }

            fileList.style.display = 'block';
            submitBtn.disabled = false;
        }
    });
</script>
