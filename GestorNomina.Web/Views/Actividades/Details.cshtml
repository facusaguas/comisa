@model GestorNomina.Web.Models.ViewModels.ActividadViewModel

@{
    ViewData["Title"] = "Detalles de la Actividad";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Detalles de la Actividad</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                        Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Información de la Actividad</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Código</div>
                                <div class="datagrid-content"><strong>@Model.Codigo</strong></div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Descripción</div>
                                <div class="datagrid-content">@Model.Descripcion</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Tipo</div>
                                <div class="datagrid-content">
                                    <span class="badge bg-@Model.BadgeColor">@Model.TipoActividad</span>
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Es Hora Efectiva</div>
                                <div class="datagrid-content">
                                    @if (Model.EsHoraEfectiva)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Es Licencia</div>
                                <div class="datagrid-content">
                                    @if (Model.EsLicencia)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Es Franco</div>
                                <div class="datagrid-content">
                                    @if (Model.EsFranco)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Características</h3>
                    </div>
                    <div class="card-body">
                        <div class="list-group list-group-flush">
                            @if (Model.EsHoraEfectiva)
                            {
                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="status-dot status-dot-animated bg-success"></span>
                                        </div>
                                        <div class="col text-truncate">
                                            <div class="text-reset d-block">Hora Efectiva</div>
                                            <div class="text-muted text-truncate mt-n1">Computa como tiempo de trabajo productivo</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.EsLicencia)
                            {
                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="status-dot status-dot-animated bg-warning"></span>
                                        </div>
                                        <div class="col text-truncate">
                                            <div class="text-reset d-block">Licencia</div>
                                            <div class="text-muted text-truncate mt-n1">Ausencia justificada</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (Model.EsFranco)
                            {
                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="status-dot status-dot-animated bg-info"></span>
                                        </div>
                                        <div class="col text-truncate">
                                            <div class="text-reset d-block">Franco</div>
                                            <div class="text-muted text-truncate mt-n1">Día de descanso</div>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!Model.EsHoraEfectiva && !Model.EsLicencia && !Model.EsFranco)
                            {
                                <div class="text-muted text-center py-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mood-empty mb-2" width="48" height="48" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <line x1="9" y1="10" x2="9.01" y2="10"></line>
                                        <line x1="15" y1="10" x2="15.01" y2="10"></line>
                                        <line x1="9" y1="15" x2="15" y2="15"></line>
                                    </svg>
                                    <p>Sin características especiales</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
