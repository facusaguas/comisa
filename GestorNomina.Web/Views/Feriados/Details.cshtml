@model GestorNomina.Web.Models.ViewModels.FeriadoViewModel

@{
    ViewData["Title"] = "Detalles del Feriado";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Detalles del Feriado</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                        Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Información del Feriado</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Fecha</div>
                                <div class="datagrid-content"><strong>@Model.FechaFormateada</strong></div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Descripción</div>
                                <div class="datagrid-content">@Model.Descripcion</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Día de la Semana</div>
                                <div class="datagrid-content">@Model.DiaSemana</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Mes</div>
                                <div class="datagrid-content">@Model.Mes</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Año</div>
                                <div class="datagrid-content">@Model.Anio</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Tipo</div>
                                <div class="datagrid-content">
                                    @if (!string.IsNullOrEmpty(Model.Tipo))
                                    {
                                        <span class="badge bg-@Model.BadgeColor">@Model.Tipo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Jurisdicción</div>
                                <div class="datagrid-content">@(Model.Jurisdiccion ?? "-")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Estado</div>
                                <div class="datagrid-content">
                                    @if (Model.EsPasado)
                                    {
                                        <span class="badge bg-secondary">Pasado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Próximo</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Calendario</h3>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <div class="display-3 text-@Model.BadgeColor">@Model.Fecha.Day</div>
                            <div class="text-uppercase text-muted">@Model.Mes @Model.Anio</div>
                        </div>
                        <div class="text-muted mb-3">@Model.DiaSemana</div>
                        <hr />
                        <div class="mt-3">
                            @if (!string.IsNullOrEmpty(Model.Tipo))
                            {
                                <div class="mb-2">
                                    <span class="badge badge-outline text-@Model.BadgeColor">@Model.Tipo</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.Jurisdiccion))
                            {
                                <div class="text-muted">@Model.Jurisdiccion</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
