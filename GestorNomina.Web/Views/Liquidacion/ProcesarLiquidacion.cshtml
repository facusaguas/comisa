@model List<GestorNomina.Web.Models.Entities.PeriodoCarga>

@{
    ViewData["Title"] = "Procesar Liquidación";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-calculator" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                        <rect x="8" y="7" width="8" height="3" rx="1"></rect>
                        <line x1="8" y1="14" x2="8" y2="14.01"></line>
                        <line x1="12" y1="14" x2="12" y2="14.01"></line>
                        <line x1="16" y1="14" x2="16" y2="14.01"></line>
                        <line x1="8" y1="17" x2="8" y2="17.01"></line>
                        <line x1="12" y1="17" x2="12" y2="17.01"></line>
                        <line x1="16" y1="17" x2="16" y2="17.01"></line>
                    </svg>
                    Procesar Liquidación
                </h2>
                <div class="text-muted mt-1">Paso 4: Cálculo de liquidaciones de sueldos</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a asp-action="Recibos" class="btn">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 5h-2a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-12a2 2 0 0 0 -2 -2h-2" /><rect x="9" y="3" width="6" height="4" rx="2" /><line x1="9" y1="12" x2="9.01" y2="12" /><line x1="13" y1="12" x2="15" y2="12" /><line x1="9" y1="16" x2="9.01" y2="16" /><line x1="13" y1="16" x2="15" y2="16" /></svg>
                    Ver Recibos
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <!-- Instrucciones -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-blue-lt">
                        <h3 class="card-title">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12.01" y2="8" /><polyline points="11 12 12 12 12 16 13 16" /></svg>
                            Sobre el Proceso de Liquidación
                        </h3>
                    </div>
                    <div class="card-body">
                        <p>El proceso de liquidación ejecuta los siguientes pasos automáticamente:</p>
                        <ol class="mb-0">
                            <li><strong>Agregador de Horas:</strong> Clasifica las horas en normales, extras 50%, extras 100%, etc.</li>
                            <li><strong>Conceptos Remunerativos:</strong> Calcula los importes de todos los conceptos (básico, extras, plus asistencia, etc.)</li>
                            <li><strong>Neto Convenido (Grossing-Up):</strong> Ajusta el bruto si el empleado tiene sueldo neto convenido</li>
                            <li><strong>Deducciones:</strong> Calcula jubilación, obra social, sindicato, etc.</li>
                            <li><strong>Cierre:</strong> Genera el recibo final con todos los detalles</li>
                        </ol>
                    </div>
                </div>
            </div>

            <!-- Periodos Disponibles -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Periodos Aprobados Disponibles</h3>
                    </div>
                    @if (!Model.Any())
                    {
                        <div class="card-body">
                            <div class="empty">
                                <div class="empty-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><line x1="9" y1="10" x2="9.01" y2="10" /><line x1="15" y1="10" x2="15.01" y2="10" /><path d="M9.5 15.25a3.5 3.5 0 0 1 5 0" /></svg>
                                </div>
                                <p class="empty-title">No hay periodos aprobados</p>
                                <p class="empty-subtitle text-muted">
                                    Debe aprobar los registros de horas antes de procesar la liquidación
                                </p>
                                <div class="empty-action">
                                    <a asp-action="PeriodosCarga" class="btn btn-primary">
                                        Ver Periodos
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var periodo in Model)
                            {
                                <div class="list-group-item">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <span class="avatar">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><rect x="4" y="5" width="16" height="16" rx="2" /><line x1="16" y1="3" x2="16" y2="7" /><line x1="8" y1="3" x2="8" y2="7" /><line x1="4" y1="11" x2="20" y2="11" /><rect x="8" y="15" width="2" height="2" /></svg>
                                            </span>
                                        </div>
                                        <div class="col">
                                            <div class="text-truncate">
                                                <strong>@periodo.Proyecto.Nombre</strong> - @periodo.Anio-@periodo.Mes.ToString("00")
                                            </div>
                                            <div class="text-muted">Código: @periodo.Proyecto.Codigo</div>
                                        </div>
                                        <div class="col-auto">
                                            <form asp-action="ProcesarLiquidacionMasiva" method="post" class="d-inline" onsubmit="return confirm('¿Procesar liquidación de TODOS los empleados del periodo @periodo.Anio-@periodo.Mes.ToString("00") quincena 1?')">
                                                <input type="hidden" name="periodo" value="@periodo.Anio-@periodo.Mes.ToString("00")" />
                                                <input type="hidden" name="quincena" value="1" />
                                                <button type="submit" class="btn btn-primary">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                                                    1ra Quincena
                                                </button>
                                            </form>
                                            <form asp-action="ProcesarLiquidacionMasiva" method="post" class="d-inline ms-2" onsubmit="return confirm('¿Procesar liquidación de TODOS los empleados del periodo @periodo.Anio-@periodo.Mes.ToString("00") quincena 2?')">
                                                <input type="hidden" name="periodo" value="@periodo.Anio-@periodo.Mes.ToString("00")" />
                                                <input type="hidden" name="quincena" value="2" />
                                                <button type="submit" class="btn btn-primary">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                                                    2da Quincena
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
