@model List<dynamic>

@{
    ViewData["Title"] = "Exportar a Tango";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><line x1="12" y1="11" x2="12" y2="17" /><polyline points="9 14 12 17 15 14" /></svg>
                    Exportar a Tango
                </h2>
                <div class="text-muted mt-1">Paso 5: Generar archivo de exportación para Tango</div>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="Recibos" class="btn">Volver a Recibos</a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-lg-8 mx-auto">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Seleccionar Periodo/Quincena</h3>
                    </div>
                    <div class="card-body">
                        @if (!Model.Any())
                        {
                            <div class="empty">
                                <p class="empty-title">No hay recibos para exportar</p>
                                <p class="empty-subtitle text-muted">Debe procesar liquidaciones primero</p>
                                <div class="empty-action">
                                    <a asp-action="ProcesarLiquidacion" class="btn btn-primary">Procesar Liquidación</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in Model)
                                {
                                    <div class="list-group-item">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <strong>Periodo:</strong> @item.Periodo<br>
                                                <strong>Quincena:</strong> @(item.Quincena == 1 ? "Primera" : "Segunda")
                                            </div>
                                            <div class="col-auto">
                                                <form asp-action="GenerarArchivoTango" method="post">
                                                    <input type="hidden" name="periodo" value="@item.Periodo" />
                                                    <input type="hidden" name="quincena" value="@item.Quincena" />
                                                    <button type="submit" class="btn btn-success">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><polyline points="7 11 12 16 17 11" /><line x1="12" y1="4" x2="12" y2="16" /></svg>
                                                        Descargar TXT
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
