@model GestorNomina.Web.Models.ViewModels.RegistrosPendientesViewModel

@{
    ViewData["Title"] = "Registros Pendientes de Aprobación";
    var nombreMes = new System.Globalization.CultureInfo("es-ES").DateTimeFormat.GetMonthName(Model.Mes);
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    Proyecto: @Model.ProyectoNombre | @nombreMes.ToUpper() @Model.Anio - @(Model.Quincena == 1 ? "1ra" : "2da") Quincena
                </div>
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-clock-pause" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M20.942 13.018a9 9 0 1 0 -7.909 7.922"></path>
                        <path d="M12 7v5l2 2"></path>
                        <path d="M17 17v5"></path>
                        <path d="M21 17v5"></path>
                    </svg>
                    Parte Diario - Registros Pendientes
                </h2>
                <div class="text-muted mt-1">@Model.TotalRegistros registros | @Model.Empleados.Count empleados</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="PeriodosCarga" class="btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11l-4 4l4 4m-4 -4h11a4 4 0 0 0 0 -8h-1" /></svg>
                        Volver
                    </a>
                    @if (Model.Empleados.Any())
                    {
                        <form asp-action="AprobarAutomaticamente" method="post" style="display:inline;">
                            <input type="hidden" name="periodoCargaId" value="@Model.PeriodoCargaId" />
                            <button type="submit" class="btn btn-success" onclick="return confirm('¿Está seguro de aprobar automáticamente todos los registros sin modificaciones?')">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 11 12 14 20 6" /><path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9" /></svg>
                                Aprobar Todo
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-fluid">
        @if (!Model.Empleados.Any())
        {
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="empty">
                                <div class="empty-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 11 12 14 20 6" /><path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9" /></svg>
                                </div>
                                <p class="empty-title">Todos los registros han sido aprobados</p>
                                <p class="empty-subtitle text-muted">
                                    Puede proceder con la liquidación
                                </p>
                                <div class="empty-action">
                                    <a asp-action="RegistrosAprobados" asp-route-periodoCargaId="@Model.PeriodoCargaId" class="btn btn-primary">
                                        Ver Registros Aprobados
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Parte Diario por Empleado</h3>
                    <div class="ms-auto">
                        <input type="text" class="form-control form-control-sm" placeholder="Buscar empleado..." id="searchBox" style="width: 250px;">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-striped" id="parteDiarioTable" style="font-size: 0.875rem;">
                        <thead>
                            <tr>
                                <th class="text-center" style="min-width: 80px;">LEGAJO</th>
                                <th style="min-width: 200px;">APELLIDO Y NOMBRE</th>
                                @foreach (var dia in Model.DiasQuincena)
                                {
                                    <th class="text-center" style="width: 50px; padding: 4px;">@dia</th>
                                }
                                <th class="text-center" style="min-width: 80px;">TOTAL</th>
                                <th class="text-center" style="min-width: 100px;">ACCIONES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var empleado in Model.Empleados)
                            {
                                <tr>
                                    <td class="text-center">
                                        <strong>@empleado.Legajo</strong>
                                    </td>
                                    <td>
                                        <strong>@empleado.Apellido</strong>, @empleado.Nombre
                                    </td>
                                    @foreach (var dia in Model.DiasQuincena)
                                    {
                                        <td class="text-center" style="padding: 4px;">
                                            @if (empleado.HorasPorDia.ContainsKey(dia))
                                            {
                                                var horas = empleado.HorasPorDia[dia];
                                                <span class="badge @(horas > 0 ? "bg-success" : "bg-secondary")" style="font-size: 0.75rem; min-width: 40px;">
                                                    @horas.ToString("0.##")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    }
                                    <td class="text-center">
                                        <strong class="text-primary" style="font-size: 1rem;">@empleado.TotalHoras.ToString("0.00")</strong>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="EditarHorasEmpleado" 
                                           asp-route-periodoCargaId="@Model.PeriodoCargaId" 
                                           asp-route-legajo="@empleado.Legajo"
                                           class="btn btn-sm btn-primary"
                                           title="Editar horas del empleado">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background-color: #f8f9fa; font-weight: bold;">
                                <td colspan="2" class="text-end">TOTALES POR DÍA:</td>
                                @foreach (var dia in Model.DiasQuincena)
                                {
                                    var totalDia = Model.Empleados.Sum(e => e.HorasPorDia.ContainsKey(dia) ? e.HorasPorDia[dia] : 0);
                                    <td class="text-center">
                                        <strong class="text-info">@totalDia.ToString("0.##")</strong>
                                    </td>
                                }
                                <td class="text-center">
                                    <strong class="text-primary" style="font-size: 1.1rem;">
                                        @Model.Empleados.Sum(e => e.TotalHoras).ToString("0.00")
                                    </strong>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="card-footer">
                    <div class="row align-items-center">
                        <div class="col">
                            <div class="text-muted">
                                <strong>Leyenda:</strong>
                                <span class="badge bg-success ms-2">Con horas</span>
                                <span class="badge bg-secondary ms-2">Sin horas</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Búsqueda en la tabla
        document.addEventListener('DOMContentLoaded', function() {
            var searchBox = document.getElementById('searchBox');
            if (searchBox) {
                searchBox.addEventListener('keyup', function() {
                    var value = this.value.toLowerCase();
                    var rows = document.querySelectorAll('#parteDiarioTable tbody tr');
                    rows.forEach(function(row) {
                        var text = row.textContent.toLowerCase();
                        row.style.display = text.includes(value) ? '' : 'none';
                    });
                });
            }
        });
    </script>
}
