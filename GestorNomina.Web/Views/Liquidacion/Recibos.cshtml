@model List<GestorNomina.Web.Models.Entities.Recibo>

@{
    ViewData["Title"] = "Recibos de Sueldo";
    var periodoFiltro = ViewBag.PeriodoFiltro as string;
    var quincenaFiltro = ViewBag.QuincenaFiltro as int?;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-receipt" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16l-3 -2l-2 2l-2 -2l-2 2l-2 -2l-3 2m4 -14h6m-6 4h6m-2 4h2"></path>
                    </svg>
                    Recibos de Sueldo
                </h2>
                <div class="text-muted mt-1">@Model.Count recibos generados</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="ProcesarLiquidacion" class="btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11l-4 4l4 4m-4 -4h11a4 4 0 0 0 0 -8h-1" /></svg>
                        Procesar Liquidación
                    </a>
                    <a asp-action="ExportarTango" class="btn btn-success">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><line x1="12" y1="11" x2="12" y2="17" /><polyline points="9 14 12 17 15 14" /></svg>
                        Exportar a Tango
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <!-- Filtros -->
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form asp-action="Recibos" method="get" class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Periodo</label>
                                <input type="month" 
                                       name="periodo" 
                                       class="form-control" 
                                       value="@periodoFiltro" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Quincena</label>
                                <select name="quincena" class="form-select">
                                    <option value="">Todas</option>
                                    <option value="1" selected="@(quincenaFiltro == 1)">Primera (1-15)</option>
                                    <option value="2" selected="@(quincenaFiltro == 2)">Segunda (16-fin)</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary me-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="10" cy="10" r="7" /><line x1="21" y1="21" x2="15" y2="15" /></svg>
                                    Filtrar
                                </button>
                                <a asp-action="Recibos" class="btn">Limpiar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Listado -->
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Listado de Recibos</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-striped">
                            <thead>
                                <tr>
                                    <th>Legajo</th>
                                    <th>Empleado</th>
                                    <th>Periodo</th>
                                    <th>Quincena</th>
                                    <th>Días</th>
                                    <th>Total Bruto</th>
                                    <th>Deducciones</th>
                                    <th>Total Neto</th>
                                    <th class="w-1">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted">No hay recibos generados con los filtros seleccionados</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var recibo in Model)
                                    {
                                        <tr>
                                            <td><strong>@recibo.Empleado.Legajo</strong></td>
                                            <td>
                                                @recibo.Empleado.Apellido, @recibo.Empleado.Nombre
                                                @if (recibo.Empleado.Categoria != null)
                                                {
                                                    <div class="text-muted small">@recibo.Empleado.Categoria.Nombre</div>
                                                }
                                            </td>
                                            <td>@recibo.Periodo</td>
                                            <td>
                                                <span class="badge bg-azure-lt">
                                                    @(recibo.Quincena == 1 ? "1ra" : "2da")
                                                </span>
                                            </td>
                                            <td>@recibo.DiasTrabajados.ToString("N2")</td>
                                            <td class="text-end">
                                                <strong>$@recibo.TotalBruto.ToString("N2")</strong>
                                            </td>
                                            <td class="text-end text-danger">
                                                <strong>$@recibo.TotalDeducciones.ToString("N2")</strong>
                                            </td>
                                            <td class="text-end">
                                                <strong class="text-success">$@recibo.TotalNeto.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <a asp-action="DetalleRecibo" asp-route-id="@recibo.Id" class="btn btn-sm btn-primary" title="Ver Detalle">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (Model.Any())
                            {
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="5">TOTALES:</td>
                                        <td class="text-end">$@Model.Sum(r => r.TotalBruto).ToString("N2")</td>
                                        <td class="text-end text-danger">$@Model.Sum(r => r.TotalDeducciones).ToString("N2")</td>
                                        <td class="text-end text-success">$@Model.Sum(r => r.TotalNeto).ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
