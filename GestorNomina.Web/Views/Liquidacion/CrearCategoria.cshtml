@model GestorNomina.Web.Models.Entities.Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
    var convenios = ViewBag.Convenios as List<GestorNomina.Web.Models.Entities.Convenio>;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Nueva Categoría Laboral</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="card">
                    <div class="card-body">
                        <form asp-action="CrearCategoria" method="post">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label required">Código</label>
                                        <input asp-for="Codigo" class="form-control" placeholder="Ej: OFICIAL" required />
                                        <span asp-validation-for="Codigo" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label required">Nombre</label>
                                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Oficial Especializado" required />
                                        <span asp-validation-for="Nombre" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Convenio</label>
                                <select asp-for="ConvenioId" class="form-select">
                                    <option value="">Seleccione convenio...</option>
                                    @if (convenios != null)
                                    {
                                        @foreach (var convenio in convenios)
                                        {
                                            <option value="@convenio.Id">@convenio.Nombre</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="ConvenioId" class="text-danger"></span>
                                <small class="form-hint">Opcional - Asignar a un convenio específico</small>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2" /><circle cx="12" cy="14" r="2" /><polyline points="14 4 14 8 8 8 8 4" /></svg>
                                    Guardar
                                </button>
                                <a asp-action="Categorias" class="btn">Cancelar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
