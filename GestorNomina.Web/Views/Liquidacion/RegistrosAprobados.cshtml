@model GestorNomina.Web.Models.ViewModels.RegistrosPendientesViewModel

@{
    ViewData["Title"] = "Registros Aprobados";
    var periodo = ViewBag.Periodo as GestorNomina.Web.Models.Entities.PeriodoCarga;
    var totalHoras = Model.Empleados.Sum(e => e.TotalHoras);
    var totalEmpleados = Model.Empleados.Count;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    Proyecto: @periodo?.Proyecto.Nombre | Periodo: @Model.Periodo | Quincena @Model.Quincena
                </div>
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-circle-check" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M9 12l2 2l4 -4"></path>
                    </svg>
                    Registros Aprobados
                </h2>
                <div class="text-muted mt-1">
                    @totalEmpleados empleados | @Model.TotalRegistros registros | @totalHoras.ToString("N2") horas totales
                </div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a asp-action="PeriodosCarga" class="btn">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11l-4 4l4 4m-4 -4h11a4 4 0 0 0 0 -8h-1" /></svg>
                        Volver
                    </a>
                    <a asp-action="ProcesarLiquidacion" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                        Procesar Liquidación
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        @if (Model.Empleados.Any())
        {
            <!-- Resumen -->
            <div class="row row-cards mb-3">
                <div class="col-sm-6 col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="subheader">Total Empleados</div>
                            </div>
                            <div class="h1 mb-0">@totalEmpleados</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="subheader">Total Registros</div>
                            </div>
                            <div class="h1 mb-0">@Model.TotalRegistros</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <div class="subheader">Total Horas</div>
                            </div>
                            <div class="h1 mb-0">@totalHoras.ToString("N2")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Matriz de Horas por Empleado -->
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Parte Diario Aprobado - Quincena @Model.Quincena</h3>
                            <div class="card-actions">
                                <span class="badge bg-success">Estado: Aprobado</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered table-vcenter card-table">
                                    <thead>
                                        <tr class="text-center">
                                            <th class="text-start" style="min-width: 80px;">LEG</th>
                                            <th class="text-start" style="min-width: 150px;">APELLIDO</th>
                                            <th class="text-start" style="min-width: 150px;">NOMBRE</th>
                                            @foreach (var dia in Model.DiasQuincena)
                                            {
                                                <th style="min-width: 50px;">@dia</th>
                                            }
                                            <th class="bg-azure-lt" style="min-width: 70px;">TOTAL</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var empleado in Model.Empleados)
                                        {
                                            <tr>
                                                <td class="text-start">
                                                    <strong>@empleado.Legajo</strong>
                                                </td>
                                                <td class="text-start">@empleado.Apellido</td>
                                                <td class="text-start">@empleado.Nombre</td>
                                                @foreach (var dia in Model.DiasQuincena)
                                                {
                                                    <td class="text-center">
                                                        @if (empleado.HorasPorDia.ContainsKey(dia) && empleado.HorasPorDia[dia] > 0)
                                                        {
                                                            <span class="badge bg-blue-lt">@empleado.HorasPorDia[dia].ToString("N1")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                }
                                                <td class="text-center bg-azure-lt">
                                                    <strong>@empleado.TotalHoras.ToString("N2")</strong>
                                                </td>
                                            </tr>
                                        }
                                        <!-- Fila de Totales -->
                                        <tr class="fw-bold bg-light">
                                            <td colspan="3" class="text-end">TOTALES:</td>
                                            @foreach (var dia in Model.DiasQuincena)
                                            {
                                                var totalDia = Model.Empleados.Sum(e => 
                                                    e.HorasPorDia.ContainsKey(dia) ? e.HorasPorDia[dia] : 0);
                                                <td class="text-center">
                                                    @if (totalDia > 0)
                                                    {
                                                        <span>@totalDia.ToString("N1")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                            }
                                            <td class="text-center bg-azure">
                                                <strong>@totalHoras.ToString("N2")</strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer text-muted">
                            <div class="row align-items-center">
                                <div class="col">
                                    <small>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-info-circle" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                            <circle cx="12" cy="12" r="9"></circle>
                                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                            <polyline points="11 12 12 12 12 16 13 16"></polyline>
                                        </svg>
                                        Los registros han sido aprobados y están listos para procesar la liquidación.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Sin Registros -->
            <div class="row row-cards">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <div class="empty">
                                <div class="empty-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mood-empty" width="48" height="48" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <circle cx="12" cy="12" r="9"></circle>
                                        <line x1="9" y1="10" x2="9.01" y2="10"></line>
                                        <line x1="15" y1="10" x2="15.01" y2="10"></line>
                                        <line x1="9" y1="15" x2="15" y2="15"></line>
                                    </svg>
                                </div>
                                <p class="empty-title">No hay registros aprobados</p>
                                <p class="empty-subtitle text-muted">
                                    Aún no se han aprobado registros para este periodo.
                                </p>
                                <div class="empty-action">
                                    <a asp-action="PeriodosCarga" class="btn btn-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 11l-4 4l4 4m-4 -4h11a4 4 0 0 0 0 -8h-1" /></svg>
                                        Volver a Periodos
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .table-bordered td, .table-bordered th {
        border: 1px solid #e6e7e9;
    }
    
    .table-sm td, .table-sm th {
        padding: 0.5rem 0.25rem;
        font-size: 0.875rem;
    }
    
    thead th {
        background-color: #f8f9fa;
        font-weight: 600;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    
    .badge {
        font-weight: 500;
    }
</style>
