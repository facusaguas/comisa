@model List<GestorNomina.Web.Models.Entities.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Categorías Laborales</h2>
                <div class="text-muted mt-1">@Model.Count categorías registradas</div>
            </div>
            <div class="col-auto ms-auto">
                <a asp-action="CrearCategoria" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Nueva Categoría
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Convenio</th>
                            <th class="w-1">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No hay categorías registradas</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var categoria in Model)
                            {
                                <tr>
                                    <td><strong>@categoria.Codigo</strong></td>
                                    <td>@categoria.Nombre</td>
                                    <td>
                                        @if (categoria.Convenio != null)
                                        {
                                            <span class="badge bg-blue-lt">@categoria.Convenio.Nombre</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="EditarCategoria" asp-route-id="@categoria.Id" class="btn btn-sm btn-primary">Editar</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
