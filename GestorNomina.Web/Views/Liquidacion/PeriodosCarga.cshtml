@model List<GestorNomina.Web.Models.Entities.PeriodoCarga>

@{
    ViewData["Title"] = "Periodos de Carga";
    var totalPeriodos = Model.Count;
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-calendar-event" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <rect x="4" y="5" width="16" height="16" rx="2"></rect>
                        <line x1="16" y1="3" x2="16" y2="7"></line>
                        <line x1="8" y1="3" x2="8" y2="7"></line>
                        <line x1="4" y1="11" x2="20" y2="11"></line>
                        <rect x="8" y="15" width="2" height="2"></rect>
                    </svg>
                    Periodos de Carga
                </h2>
                <div class="text-muted mt-1">@totalPeriodos periodos encontrados</div>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <a asp-action="ImportarHoras" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Importar Nuevo Periodo
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-deck row-cards">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Listado de Periodos</h3>
                    </div>
                    
                    <!-- Panel de Filtros -->
                    <div class="card-body border-bottom">
                        <form method="get" asp-action="PeriodosCarga" class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Proyecto</label>
                                <select name="proyectoId" class="form-select">
                                    <option value="">Todos los proyectos</option>
                                    @if (ViewBag.Proyectos != null)
                                    {
                                        @foreach (var proyecto in (List<GestorNomina.Web.Models.Entities.Proyecto>)ViewBag.Proyectos)
                                        {
                                            <option value="@proyecto.Id" selected="@(ViewBag.FiltroProyectoId != null && ViewBag.FiltroProyectoId == proyecto.Id)">
                                                @proyecto.Nombre
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Periodo (YYYY-MM)</label>
                                <input type="text" name="periodo" class="form-control" placeholder="2026-10" value="@ViewBag.FiltroPeriodo" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Quincena</label>
                                <select name="quincena" class="form-select">
                                    <option value="">Todas</option>
                                    <option value="1" selected="@(ViewBag.FiltroQuincena != null && ViewBag.FiltroQuincena == 1)">1ra Quincena</option>
                                    <option value="2" selected="@(ViewBag.FiltroQuincena != null && ViewBag.FiltroQuincena == 2)">2da Quincena</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Estado</label>
                                <select name="estado" class="form-select">
                                    <option value="">Todos los estados</option>
                                    <option value="Cargando" selected="@(ViewBag.FiltroEstado == "Cargando")">Cargando</option>
                                    <option value="Cargado" selected="@(ViewBag.FiltroEstado == "Cargado")">Pendiente Aprobación</option>
                                    <option value="Aprobado" selected="@(ViewBag.FiltroEstado == "Aprobado")">Aprobado</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="10" cy="10" r="7" /><line x1="21" y1="21" x2="15" y2="15" /></svg>
                                    Filtrar
                                </button>
                            </div>
                        </form>
                        @if (ViewBag.FiltroProyectoId != null || ViewBag.FiltroPeriodo != null || ViewBag.FiltroQuincena != null || ViewBag.FiltroEstado != null)
                        {
                            <div class="mt-3">
                                <a asp-action="PeriodosCarga" class="btn btn-sm btn-ghost-secondary">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                    Limpiar filtros
                                </a>
                            </div>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-striped">
                            <thead>
                                <tr>
                                    <th>Proyecto</th>
                                    <th>Periodo</th>
                                    <th>Quincena</th>
                                    <th>Usuario Carga</th>
                                    <th>Fecha Carga</th>
                                    <th>Estado</th>
                                    <th class="w-1">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (totalPeriodos == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">
                                            <div class="empty">
                                                <div class="empty-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9" /><line x1="9" y1="10" x2="9.01" y2="10" /><line x1="15" y1="10" x2="15.01" y2="10" /><path d="M9.5 15.25a3.5 3.5 0 0 1 5 0" /></svg>
                                                </div>
                                                <p class="empty-title">No hay periodos cargados</p>
                                                <p class="empty-subtitle text-muted">
                                                    Comience importando un archivo Excel con las horas trabajadas
                                                </p>
                                                <div class="empty-action">
                                                    <a asp-action="ImportarHoras" class="btn btn-primary">
                                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                                                        Importar Horas
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var periodo in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@periodo.Proyecto.Nombre</strong>
                                                <div class="text-muted small">@periodo.Proyecto.Codigo</div>
                                            </td>
                                            <td>
                                                <strong>@periodo.Anio-@periodo.Mes.ToString("00")</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-azure-lt">
                                                    @(periodo.Quincena == 1 ? "1ra" : "2da") Quincena
                                                </span>
                                            </td>
                                            <td>
                                                @if (periodo.UsuarioCarga != null)
                                                {
                                                    <span>@periodo.UsuarioCarga.Nombre</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="text-muted">@periodo.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                            </td>
                                            <td>
                                                @switch (periodo.Estado)
                                                {
                                                    case "Cargando":
                                                        <span class="badge bg-info">Cargando</span>
                                                        break;
                                                    case "Cargado":
                                                        <span class="badge bg-warning">Pendiente Aprobación</span>
                                                        break;
                                                    case "Aprobado":
                                                        <span class="badge bg-success">Aprobado</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@periodo.Estado</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-list">
                                                    @if (periodo.Estado == "Cargado")
                                                    {
                                                        <a asp-action="RegistrosPendientes" asp-route-periodoCargaId="@periodo.Id" class="btn btn-sm btn-primary" title="Revisar y Aprobar">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><polyline points="9 11 12 14 20 6" /><path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9" /></svg>
                                                            Aprobar
                                                        </a>
                                                        <form asp-action="EliminarPeriodo" method="post" style="display: inline;" onsubmit="return confirm('¿Está seguro de eliminar este periodo y todos sus registros? Esta acción no se puede deshacer.');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@periodo.Id" />
                                                            <button type="submit" class="btn btn-sm btn-danger" title="Eliminar Periodo">
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><line x1="4" y1="7" x2="20" y2="7" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" /><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" /></svg>
                                                                Eliminar
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (periodo.Estado == "Aprobado")
                                                    {
                                                        <a asp-action="RegistrosAprobados" asp-route-periodoCargaId="@periodo.Id" class="btn btn-sm btn-ghost-secondary" title="Ver Registros Aprobados">
                                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="2" /><path d="M22 12c-2.667 4.667 -6 7 -10 7s-7.333 -2.333 -10 -7c2.667 -4.667 6 -7 10 -7s7.333 2.333 10 7" /></svg>
                                                            Ver
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
