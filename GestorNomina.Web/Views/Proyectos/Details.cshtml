@model GestorNomina.Web.Models.ViewModels.ProyectoViewModel

@{
    ViewData["Title"] = "Detalles del Proyecto";
}

@* Token antifalsificación para formularios *@
@Html.AntiForgeryToken()

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Detalles del Proyecto</h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalExportarEmpleados">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                            <path d="M12 11v6" />
                            <path d="M9.5 13.5l2.5 2.5l2.5 -2.5" />
                        </svg>
                        Exportar Empleados
                    </button>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" /><path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" /><path d="M16 5l3 3" /></svg>
                        Editar
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0" /><path d="M5 12l6 6" /><path d="M5 12l6 -6" /></svg>
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para exportar empleados -->
<div class="modal modal-blur fade" id="modalExportarEmpleados" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Exportar Empleados a Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formExportarEmpleados">
                    <!-- Información del Proyecto -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <h4 class="card-title">@Model.Nombre</h4>
                            <p class="text-muted">Código: <strong>@Model.Codigo</strong></p>
                            
                            <div class="row">
                                <div class="col-12">
                                    <div class="mb-2">
                                        <strong>Total de Empleados:</strong> <span id="totalEmpleados" class="badge bg-primary">@Model.CantidadEmpleados</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div id="estadisticasEmpleados" class="mt-2">
                                <div class="text-center text-muted">
                                    <div class="spinner-border spinner-border-sm" role="status"></div>
                                    Cargando estadísticas...
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Selección de Período -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label required">Mes</label>
                            <select class="form-select" id="mes" name="mes" required>
                                <option value="">Seleccione...</option>
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Año</label>
                            <select class="form-select" id="anio" name="anio" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Quincena</label>
                            <select class="form-select" id="quincena" name="quincena" required>
                                <option value="">Seleccione...</option>
                                <option value="1">Primera (1-15)</option>
                                <option value="2">Segunda (16-fin)</option>
                            </select>
                        </div>
                    </div>

                    <input type="hidden" id="proyectoId" name="proyectoId" value="@Model.Id" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnGenerarExcel" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                        <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                        <path d="M12 11v6" />
                        <path d="M9.5 13.5l2.5 2.5l2.5 -2.5" />
                    </svg>
                    Generar Excel
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modalElement = document.getElementById('modalExportarEmpleados');
            const formExportar = document.getElementById('formExportarEmpleados');
            const btnGenerarExcel = document.getElementById('btnGenerarExcel');
            const selectMes = document.getElementById('mes');
            const selectAnio = document.getElementById('anio');
            const selectQuincena = document.getElementById('quincena');
            const proyectoId = document.getElementById('proyectoId').value;

            // Inicializar select de años
            const anioActual = new Date().getFullYear();
            for (let i = anioActual - 1; i <= anioActual + 1; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = i;
                if (i === anioActual) option.selected = true;
                selectAnio.appendChild(option);
            }

            // Establecer mes actual por defecto
            const mesActual = new Date().getMonth() + 1;
            selectMes.value = mesActual;

            // Validar formulario para habilitar botón
            function validarFormulario() {
                const esValido = selectMes.value && selectAnio.value && selectQuincena.value;
                btnGenerarExcel.disabled = !esValido;
            }

            selectMes.addEventListener('change', validarFormulario);
            selectAnio.addEventListener('change', validarFormulario);
            selectQuincena.addEventListener('change', validarFormulario);

            // Cargar estadísticas al abrir el modal
            modalElement.addEventListener('show.bs.modal', function() {
                cargarEstadisticas();
            });

            // Cargar estadísticas
            function cargarEstadisticas() {
                fetch(`/Proyectos/GetEstadisticasProyecto?id=${proyectoId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success === false) {
                            mostrarError('Error al cargar estadísticas');
                            return;
                        }

                        document.getElementById('totalEmpleados').textContent = data.totalEmpleados;

                        let html = '<div class="mt-2"><strong>Por tipo de contratación:</strong><div class="mt-2">';
                        
                        if (data.empleadosPorTipoContratacion && Object.keys(data.empleadosPorTipoContratacion).length > 0) {
                            for (const [tipo, cantidad] of Object.entries(data.empleadosPorTipoContratacion)) {
                                html += `<div class="mb-1"><span class="badge bg-info-lt me-2">${tipo}</span><strong>${cantidad}</strong> empleado${cantidad !== 1 ? 's' : ''}</div>`;
                            }
                        } else {
                            html += '<div class="text-muted">Sin datos</div>';
                        }
                        
                        html += '</div></div>';
                        
                        document.getElementById('estadisticasEmpleados').innerHTML = html;
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        mostrarError('Error al cargar estadísticas');
                    });
            }

            // Generar Excel
            btnGenerarExcel.addEventListener('click', function() {
                const mes = selectMes.value;
                const anio = selectAnio.value;
                const quincena = selectQuincena.value;

                if (!mes || !anio || !quincena) {
                    alert('Por favor complete todos los campos');
                    return;
                }

                // Deshabilitar botón y mostrar estado de carga
                btnGenerarExcel.disabled = true;
                const textoOriginal = btnGenerarExcel.innerHTML;
                btnGenerarExcel.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Generando...';

                // Crear formulario para descargar
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Proyectos/DescargarExcelEmpleados';

                const inputs = [
                    { name: 'proyectoId', value: proyectoId },
                    { name: 'mes', value: mes },
                    { name: 'anio', value: anio },
                    { name: 'quincena', value: quincena }
                ];

                inputs.forEach(input => {
                    const hiddenField = document.createElement('input');
                    hiddenField.type = 'hidden';
                    hiddenField.name = input.name;
                    hiddenField.value = input.value;
                    form.appendChild(hiddenField);
                });

                // Agregar token antifalsificación
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenField = document.createElement('input');
                    tokenField.type = 'hidden';
                    tokenField.name = '__RequestVerificationToken';
                    tokenField.value = token.value;
                    form.appendChild(tokenField);
                }

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);

                // Restaurar botón después de un breve delay
                setTimeout(() => {
                    btnGenerarExcel.disabled = false;
                    btnGenerarExcel.innerHTML = textoOriginal;
                    
                    // Cerrar modal
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) modal.hide();
                }, 2000);
            });

            function mostrarError(mensaje) {
                document.getElementById('estadisticasEmpleados').innerHTML = 
                    `<div class="alert alert-danger">${mensaje}</div>`;
            }
        });
    </script>
}

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Información del Proyecto</h3>
                    </div>
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Código</div>
                                <div class="datagrid-content"><strong>@Model.Codigo</strong></div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Nombre</div>
                                <div class="datagrid-content">@Model.Nombre</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Ubicación</div>
                                <div class="datagrid-content">@(Model.Ubicacion ?? "-")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Régimen Laboral por Defecto</div>
                                <div class="datagrid-content">
                                    @if (!string.IsNullOrEmpty(Model.RegimenDefaultNombre))
                                    {
                                        <span class="badge bg-blue-lt">@Model.RegimenDefaultNombre</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Premio Final de Obra</div>
                                <div class="datagrid-content">
                                    @if (Model.PremioFinalObra.HasValue && Model.PremioFinalObra.Value > 0)
                                    {
                                        <strong class="text-green">@Model.PremioFinalObra.Value.ToString("C2")</strong>
                                        <div class="small text-muted">Se paga con compensación especial (14 días roster)</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No configurado</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Estado</div>
                                <div class="datagrid-content">
                                    @if (Model.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Cantidad de Empleados</div>
                                <div class="datagrid-content">
                                    <span class="badge bg-primary">@Model.CantidadEmpleados</span>
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Fecha de Registro</div>
                                <div class="datagrid-content">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Última Actualización</div>
                                <div class="datagrid-content">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Empleados Asignados</h3>
                    </div>
                    <div class="card-body">
                        @if (Model.EmpleadosAsignados != null && Model.EmpleadosAsignados.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var empleado in Model.EmpleadosAsignados)
                                {
                                    <div class="list-group-item">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-user text-muted" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                                                </svg>
                                            </div>
                                            <div class="col text-truncate">
                                                <div class="text-reset d-block">@empleado</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted text-center py-3">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-mood-empty mb-2" width="48" height="48" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <line x1="9" y1="10" x2="9.01" y2="10"></line>
                                    <line x1="15" y1="10" x2="15.01" y2="10"></line>
                                    <line x1="9" y1="15" x2="15" y2="15"></line>
                                </svg>
                                <p>Sin empleados asignados</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
