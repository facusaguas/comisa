@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["PreTitle"] = "Panel de Control";
    var usuarioNombre = Context.Session.GetString("UsuarioNombre") ?? "Usuario";
    var usuarioRol = Context.Session.GetString("UsuarioRol") ?? "Usuario";
}

@section Styles {
<style>
    .stat-card {
        transition: all 0.3s ease;
        border: none;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }
    .stat-value {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1;
    }
    .chart-container {
        position: relative;
        height: 300px;
    }
    .ranking-badge {
        width: 2.5rem;
        height: 2.5rem;
        line-height: 2.5rem;
        font-size: 1.1rem;
        font-weight: 700;
    }
</style>
}

<!-- Banner de Bienvenida con Selector de Mes -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card card-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body py-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar avatar-xl text-white" style="background-color: rgba(255,255,255,0.2);">
                            @usuarioNombre.Substring(0, 1).ToUpper()
                        </span>
                    </div>
                    <div class="col text-white">
                        <h1 class="mb-1 text-white">¡Bienvenido, @usuarioNombre!</h1>
                        <p class="mb-0 text-white-50">
                            <i class="ti ti-user-check me-1"></i>
                            @usuarioRol • @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-AR"))
                        </p>
                    </div>
                    <div class="col-auto">
                        <form method="get" class="d-flex gap-2 align-items-center">
                            <label class="text-white mb-0">
                                <i class="ti ti-calendar me-1"></i>
                                Ver mes:
                            </label>
                            <select name="mes" class="form-select" style="width: auto;" onchange="this.form.submit()">
                                @{
                                    var mesSelec = ViewBag.MesSeleccionado ?? DateTime.Now.Month;
                                }
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var nombreMes = new DateTime(2024, m, 1).ToString("MMMM", new System.Globalization.CultureInfo("es-AR"));
                                    if (m == mesSelec)
                                    {
                                        <option value="@m" selected>@nombreMes</option>
                                    }
                                    else
                                    {
                                        <option value="@m">@nombreMes</option>
                                    }
                                }
                            </select>
                            <select name="anio" class="form-select" style="width: auto;" onchange="this.form.submit()">
                                @{
                                    var anioActual = DateTime.Now.Year;
                                    var anioSelec = ViewBag.AnioSeleccionado ?? anioActual;
                                    for (int a = anioActual; a >= anioActual - 3; a--)
                                    {
                                        if (a == anioSelec)
                                        {
                                            <option value="@a" selected>@a</option>
                                        }
                                        else
                                        {
                                            <option value="@a">@a</option>
                                        }
                                    }
                                }
                            </select>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <div class="d-flex">
            <div>
                <i class="ti ti-alert-circle icon alert-icon"></i>
            </div>
            <div>
                <h4 class="alert-title">Error al cargar datos</h4>
                <div class="text-muted">@ViewBag.ErrorMessage</div>
            </div>
        </div>
        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
    </div>
}

@if (ViewBag.TotalHorasRegistradas != null)
{
    <div class="alert alert-info mb-3">
        <div class="d-flex">
            <div>
                <i class="ti ti-info-circle icon alert-icon"></i>
            </div>
            <div>
                <strong>Info de sistema:</strong> @ViewBag.DebugInfo
                <br/>
                <small>Mostrando datos de: @ViewBag.NombreMesSeleccionado</small>
            </div>
        </div>
    </div>
}

<!-- KPIs Principales -->
<div class="row row-cards mb-3">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Empleados</div>
                    <div class="ms-auto lh-1">
                        <div class="dropdown">
                            <a class="dropdown-toggle text-muted" href="#" data-bs-toggle="dropdown">Activos</a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item active" href="#">Activos</a>
                                <a class="dropdown-item" href="/Empleados">Ver todos</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-baseline mt-2">
                    <div class="stat-value text-primary">@ViewBag.EmpleadosActivos</div>
                    <span class="ms-2 text-muted">/ @ViewBag.TotalEmpleados</span>
                </div>
                <div class="progress progress-sm mt-2">
                    <div class="progress-bar bg-primary" style="width: @((int)ViewBag.EmpleadosActivos * 100 / Math.Max((int)ViewBag.TotalEmpleados, 1))%" 
                         role="progressbar"></div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Proyectos</div>
                    <div class="ms-auto lh-1">
                        <div class="dropdown">
                            <a class="dropdown-toggle text-muted" href="#" data-bs-toggle="dropdown">Activos</a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a class="dropdown-item active" href="#">Activos</a>
                                <a class="dropdown-item" href="/Proyectos">Ver todos</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-baseline mt-2">
                    <div class="stat-value text-success">@ViewBag.ProyectosActivos</div>
                    <span class="ms-2 text-muted">/ @ViewBag.TotalProyectos</span>
                </div>
                <div class="progress progress-sm mt-2">
                    <div class="progress-bar bg-success" style="width: @((int)ViewBag.ProyectosActivos * 100 / Math.Max((int)ViewBag.TotalProyectos, 1))%" 
                         role="progressbar"></div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Horas del Mes</div>
                    <div class="ms-auto lh-1">
                        <span class="badge bg-info text-white">
                            <i class="ti ti-calendar"></i> @ViewBag.NombreMesSeleccionado
                        </span>
                    </div>
                </div>
                <div class="d-flex align-items-baseline mt-2">
                    <div class="stat-value text-info">@String.Format("{0:N0}", ViewBag.HorasMesActual ?? 0)</div>
                    <span class="ms-2 text-muted">horas</span>
                </div>
                <div class="mt-2 small text-muted">
                    <i class="ti ti-clock"></i> Total acumulado: @String.Format("{0:N0}", ViewBag.TotalHorasAcumuladas ?? 0) h
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="subheader">Períodos Activos</div>
                    <div class="ms-auto lh-1">
                        <a class="text-muted" href="/PeriodosCarga">
                            <i class="ti ti-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="d-flex align-items-baseline mt-2">
                    <div class="stat-value text-warning">@ViewBag.PeriodosActivos</div>
                    <span class="ms-2 text-muted">abiertos</span>
                </div>
                <div class="mt-2 small text-muted">
                    <i class="ti ti-file-upload"></i> En carga este mes
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos Principales -->
<div class="row row-cards mb-3">
    <!-- Evolución de Horas -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-chart-line me-2 text-primary"></i>
                    Evolución de Horas Trabajadas
                </h3>
                <div class="card-actions">
                    <span class="badge bg-blue-lt">Últimos 6 meses</span>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartEvolucionHoras"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Distribución por Régimen -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-chart-pie me-2 text-success"></i>
                    Empleados por Régimen
                </h3>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartRegimen"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Rankings y Listados -->
<div class="row row-cards mb-3">
    <!-- Top Proyectos -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-trophy me-2 text-yellow"></i>
                    Top 5 Proyectos
                </h3>
                <div class="card-actions">
                    <a href="/Proyectos" class="btn btn-sm">Ver todos</a>
                </div>
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartTopProyectos"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Empleados -->
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-medal me-2 text-orange"></i>
                    Top 5 Empleados - @ViewBag.NombreMesSeleccionado
                </h3>
            </div>
            <div class="card-body p-0">
                @{
                    var topEmpleados = ViewBag.TopEmpleados as List<dynamic> ?? new List<dynamic>();
                    var badgeColors = new[] { "bg-yellow", "bg-gray", "bg-orange", "bg-cyan", "bg-purple" };
                }
                @if (topEmpleados.Any())
                {
                    <div class="list-group list-group-flush">
                        @for (int i = 0; i < topEmpleados.Count; i++)
                        {
                            var empleado = topEmpleados[i];
                            <div class="list-group-item">
                                <div class="row align-items-center">
                                    <div class="col-auto">
                                        <span class="badge @badgeColors[i] ranking-badge">@(i + 1)</span>
                                    </div>
                                    <div class="col">
                                        <div class="font-weight-medium">@empleado.NombreCompleto</div>
                                        <div class="text-muted small">
                                            <strong>@String.Format("{0:N1}", empleado.TotalHoras)</strong> horas trabajadas
                                        </div>
                                    </div>
                                    <div class="col-auto">
                                        <div class="progress" style="width: 120px; height: 8px;">
                                            <div class="progress-bar @badgeColors[i]" 
                                                 style="width: @Math.Min(100, empleado.TotalHoras / 200.0 * 100)%" 
                                                 role="progressbar"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty py-5">
                        <div class="empty-icon">
                            <i class="ti ti-mood-sad icon"></i>
                        </div>
                        <p class="empty-title">No hay datos</p>
                        <p class="empty-subtitle text-muted">No se registraron horas en @ViewBag.NombreMesSeleccionado</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Accesos Rápidos y Novedades -->
<div class="row row-cards mb-3">
    <!-- Accesos Rápidos -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-bolt me-2 text-danger"></i>
                    Accesos Rápidos
                </h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Empleados" class="btn btn-outline-primary w-100 py-3">
                            <i class="ti ti-user-check fs-1 mb-2"></i>
                            <div class="small">Empleados</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Proyectos" class="btn btn-outline-success w-100 py-3">
                            <i class="ti ti-briefcase fs-1 mb-2"></i>
                            <div class="small">Proyectos</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/PeriodosCarga" class="btn btn-outline-info w-100 py-3">
                            <i class="ti ti-file-upload fs-1 mb-2"></i>
                            <div class="small">Carga de Horas</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Liquidacion" class="btn btn-outline-warning w-100 py-3">
                            <i class="ti ti-calculator fs-1 mb-2"></i>
                            <div class="small">Liquidaciones</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Novedades" class="btn btn-outline-danger w-100 py-3">
                            <i class="ti ti-alert-circle fs-1 mb-2"></i>
                            <div class="small">Novedades</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/RegimenesLaborales" class="btn btn-outline-purple w-100 py-3">
                            <i class="ti ti-book fs-1 mb-2"></i>
                            <div class="small">Regímenes</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Actividades" class="btn btn-outline-teal w-100 py-3">
                            <i class="ti ti-list fs-1 mb-2"></i>
                            <div class="small">Actividades</div>
                        </a>
                    </div>
                    <div class="col-6 col-sm-4 col-md-3">
                        <a href="/Usuarios" class="btn btn-outline-azure w-100 py-3">
                            <i class="ti ti-users fs-1 mb-2"></i>
                            <div class="small">Usuarios</div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Novedades Recientes -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-bell me-2 text-red"></i>
                    Novedades Recientes
                </h3>
            </div>
            @{
                var novedades = ViewBag.NovedadesRecientes as List<GestorNomina.Web.Models.Entities.Novedad> ?? new List<GestorNomina.Web.Models.Entities.Novedad>();
            }
            @if (novedades.Any())
            {
                <div class="list-group list-group-flush list-group-hoverable">
                    @foreach (var novedad in novedades)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <span class="avatar avatar-sm">@novedad.Empleado.Nombre.Substring(0, 1)@novedad.Empleado.Apellido.Substring(0, 1)</span>
                                </div>
                                <div class="col text-truncate">
                                    <div class="text-reset d-block">@novedad.Empleado.Nombre @novedad.Empleado.Apellido</div>
                                    <div class="text-muted text-truncate mt-n1">
                                        <span class="badge badge-sm bg-blue-lt">@novedad.TipoNovedad.ToString()</span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <div class="text-muted small">
                                        @novedad.FechaNovedad.ToString("dd/MM")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <a href="/Novedades" class="btn btn-link w-100">Ver todas las novedades</a>
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="empty py-4">
                        <div class="empty-icon">
                            <i class="ti ti-file-off"></i>
                        </div>
                        <p class="empty-title">Sin novedades</p>
                        <p class="empty-subtitle text-muted">No hay novedades registradas</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Información del Sistema -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-info-circle me-2"></i>
                    Información del Sistema
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-6">
                        <div class="text-center">
                            <div class="h1 mb-1">@ViewBag.TotalUsuarios</div>
                            <div class="text-muted small">Usuarios registrados</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-center">
                            <div class="h1 mb-1">@ViewBag.TotalRegimenes</div>
                            <div class="text-muted small">Regímenes laborales</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-center">
                            <div class="h1 mb-1">@ViewBag.TotalActividades</div>
                            <div class="text-muted small">Actividades configuradas</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-center">
                            <div class="h1 mb-1">1.0</div>
                            <div class="text-muted small">Versión del sistema</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Configuración de colores
    const colors = {
        primary: '#206bc4',
        success: '#2fb344',
        info: '#4299e1',
        warning: '#f76707',
        danger: '#d63939',
        purple: '#ae3ec9',
        teal: '#0ca678',
        yellow: '#fab005',
        orange: '#fd7e14',
        cyan: '#17a2b8',
        gray: '#868e96'
    };

    Chart.defaults.font.family = 'inherit';
    Chart.defaults.color = '#626976';

    // Datos para evolución de horas
    @{
        var horasPorMes = ViewBag.HorasPorMes as List<dynamic> ?? new List<dynamic>();
        var labels = horasPorMes.Select(h => 
            new DateTime((int)h.Anio, (int)h.Mes, 1)
                .ToString("MMM yyyy", new System.Globalization.CultureInfo("es-AR"))
        ).ToList();
        var valores = horasPorMes.Select(h => h.Total).ToList();
    }

    const dataEvolucion = @Html.Raw(JsonSerializer.Serialize(valores));
    const labelsEvolucion = @Html.Raw(JsonSerializer.Serialize(labels));

    // Gráfico de evolución
    new Chart(document.getElementById('chartEvolucionHoras'), {
        type: 'line',
        data: {
            labels: labelsEvolucion,
            datasets: [{
                label: 'Horas',
                data: dataEvolucion,
                borderColor: colors.primary,
                backgroundColor: colors.primary + '20',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointRadius: 6,
                pointHoverRadius: 8,
                pointBackgroundColor: colors.primary,
                pointBorderColor: '#fff',
                pointBorderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                    padding: 12,
                    callbacks: {
                        label: ctx => ctx.parsed.y.toLocaleString('es-AR') + ' horas'
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: value => value.toLocaleString('es-AR')
                    }
                }
            }
        }
    });

    // Distribución por régimen
    @{
        var regimenes = ViewBag.EmpleadosPorRegimen as List<dynamic> ?? new List<dynamic>();
        var regLabels = regimenes.Select(r => r.Regimen).ToList();
        var regValores = regimenes.Select(r => r.Cantidad).ToList();
    }

    const dataRegimen = @Html.Raw(JsonSerializer.Serialize(regValores));
    const labelsRegimen = @Html.Raw(JsonSerializer.Serialize(regLabels));

    new Chart(document.getElementById('chartRegimen'), {
        type: 'doughnut',
        data: {
            labels: labelsRegimen,
            datasets: [{
                data: dataRegimen,
                backgroundColor: [colors.primary, colors.success, colors.warning, colors.info, colors.purple, colors.teal],
                borderWidth: 3,
                borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' },
                tooltip: {
                    callbacks: {
                        label: ctx => {
                            const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                            const pct = ((ctx.parsed / total) * 100).toFixed(1);
                            return ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                        }
                    }
                }
            }
        }
    });

    // Top proyectos
    @{
        var proyectos = ViewBag.TopProyectos as List<dynamic> ?? new List<dynamic>();
        var proyLabels = proyectos.Select(p => p.Codigo).ToList();
        var proyValores = proyectos.Select(p => p.TotalHoras).ToList();
    }

    const dataProyectos = @Html.Raw(JsonSerializer.Serialize(proyValores));
    const labelsProyectos = @Html.Raw(JsonSerializer.Serialize(proyLabels));

    new Chart(document.getElementById('chartTopProyectos'), {
        type: 'bar',
        data: {
            labels: labelsProyectos,
            datasets: [{
                label: 'Horas',
                data: dataProyectos,
                backgroundColor: [colors.success, colors.primary, colors.info, colors.warning, colors.purple],
                borderRadius: 8,
                borderSkipped: false
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: ctx => ctx.parsed.x.toLocaleString('es-AR') + ' horas'
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        callback: value => value.toLocaleString('es-AR')
                    }
                }
            }
        }
    });
</script>
}
