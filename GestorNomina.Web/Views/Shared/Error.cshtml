@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["PageTitle"] = "Error";
    ViewData["PagePretitle"] = "Sistema";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <i class="ti ti-alert-triangle" style="font-size: 5rem; color: #d63939;"></i>
                </div>
                
                <h2 class="card-title mb-3">¡Algo salió mal!</h2>
                
                <p class="text-muted mb-4">
                    Lo sentimos, ocurrió un error al procesar tu solicitud.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-warning text-start">
                        <div class="d-flex">
                            <div>
                                <i class="ti ti-info-circle icon alert-icon"></i>
                            </div>
                            <div>
                                <h4 class="alert-title">ID de Solicitud</h4>
                                <div class="text-muted">
                                    <code>@Model.RequestId</code>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <a href="/" class="btn btn-primary">
                        <i class="ti ti-home icon"></i>
                        Volver al Inicio
                    </a>
                    <button onclick="history.back()" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left icon"></i>
                        Regresar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
